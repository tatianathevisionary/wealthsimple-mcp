{
    "name": "wealthsimple-help-center-mcp",
    "version": "0.1.0",
    "description": "Unofficial, community-built Model Context Protocol server that exposes the Wealthsimple Help Center (https://help.wealthsimple.com/hc/en-ca) to AI agents via the public Zendesk Help Center JSON API. Not affiliated with Wealthsimple Technologies Inc.",
    "license": "MIT",
    "author": "Tatiana the Visionary (https://github.com/tatianathevisionary)",
    "homepage": "https://github.com/tatianathevisionary/wealthsimple-mcp#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tatianathevisionary/wealthsimple-mcp.git"
    },
    "bugs": {
        "url": "https://github.com/tatianathevisionary/wealthsimple-mcp/issues"
    },
    "type": "module",
    "main": "./build/index.js",
    "bin": {
        "wealthsimple-help-center-mcp": "./build/index.js"
    },
    "files": [
        "build",
        "src",
        "README.md",
        "CLAUDE.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node build/index.js",
        "start:telemetry": "node --env-file=.env build/index.js",
        "dev": "tsx watch src/index.ts",
        "dev:telemetry": "tsx watch --env-file=.env src/index.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "mcp",
        "modelcontextprotocol",
        "wealthsimple",
        "help-center",
        "zendesk",
        "ai-agent"
    ],
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "dd-trace": "^5.101.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@types/node": "^24.10.1",
        "tsx": "^4.20.4",
        "typescript": "^5.9.3",
        "vitest": "^4.1.8"
    }
}
