# Copy this file to `.env` and fill in real values for local dev with telemetry.
# `.env` is gitignored; this file is checked in as documentation.
#
# Usage: `node --env-file=.env build/index.js`  (Node 20+ has native --env-file)
# Or:    `npm run start:telemetry`

# Datadog credentials. Get a fresh API key at:
#   https://app.datadoghq.com/organization-settings/api-keys
#   (or your regional URL, e.g. https://us5.datadoghq.com/...)
DD_API_KEY=
DD_SITE=us5.datadoghq.com

# APM identification (shown in Datadog UI for service search/grouping)
DD_SERVICE=wealthsimple-help-center-mcp
DD_ENV=dev
DD_VERSION=0.1.0

# LLM Observability
# - DD_LLMOBS_ENABLED=true to capture each MCP tool call as an LLM Obs `tool` span.
# - DD_LLMOBS_AGENTLESS_ENABLED=true sends spans directly to Datadog without
#   needing a local Datadog Agent (the typical local-dev setup).
DD_LLMOBS_ENABLED=true
# DD_LLMOBS_ML_APP must match the "Application Name" you typed into the
# Datadog LLM Observability onboarding wizard.
DD_LLMOBS_ML_APP=wealthsimple-mcp
DD_LLMOBS_AGENTLESS_ENABLED=true
